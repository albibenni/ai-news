{
  "name": "ai-news",
  "version": "1.0.0",
  "description": "ai news summarizer and article generator",
  "author": "Alberto Benatti",
  "main": "./src/main.ts",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env src/main.ts",
    "test": "vitest run",
    "indent:write": "prettier . --write",
    "claude:ln": "ln -s AGENTS.md CLAUDE.md",
    "gemini:ln": "ln -s AGENTS.md GEMINI.md",
    "devtools": "pnpx @ai-sdk/devtools"
  },
  "keywords": [
    "ai",
    "news",
    "summarizer",
    "article",
    "generator"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.1",
    "@types/node": "^25.1.0",
    "autoevals": "^0.0.131",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "evalite": "^0.19.0",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.49.0",
    "vitest": "4.0.15"
  },
  "dependencies": {
    "@ai-sdk/devtools": "0.0.4",
    "@ai-sdk/openai": "3.0.7",
    "ai": "6.0.25",
    "zod": "4.3.5"
  }
}
